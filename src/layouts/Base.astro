---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import {
  DEFAULT_MARKET,
  MARKETS,
  isMarket,
  marketHreflang,
} from "@/lib/utils/markets";
import { buildBreadcrumbs } from "@/lib/utils/breadcrumbs";
import Breadcrumbs from "@/layouts/components/Breadcrumbs.astro";
import Schema from "@/layouts/components/Schema.astro";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import WhatsAppFloat from "@/layouts/components/WhatsAppFloat.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  /** Texto del último nivel del breadcrumb (por defecto, el título de la página). */
  breadcrumbLabel?: string;
  /** Datos extra para el JSON-LD específico del tipo de página. */
  schema?: {
    kind?: "webpage" | "article" | "creativeWork" | "service";
    datePublished?: string | Date;
    dateModified?: string | Date;
    author?: string;
    image?: string;
    serviceType?: string;
  };
}

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  breadcrumbLabel,
  schema,
} = Astro.props;

// --- Arquitectura SEO multi-mercado (México, Argentina, España) ---
// Las páginas bajo /mx, /ar y /es son variantes regionales del mismo idioma.
// Se declaran entre sí con hreflang para que los buscadores no las traten
// como contenido duplicado y muestren la versión del país del usuario.
const siteUrl = config.site.base_url.replace(/\/$/, "");
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const segments = pathname.split("/").filter(Boolean);
const currentMarket = isMarket(segments[0]) ? segments[0] : null;
const marketRest = currentMarket ? segments.slice(1).join("/") : null;

const canonicalUrl = canonical ?? `${siteUrl}${pathname === "/" ? "/" : pathname}`;
const htmlLang = marketHreflang(currentMarket ?? undefined);

const marketAlternates = currentMarket
  ? MARKETS.map((market) => ({
      hreflang: marketHreflang(market),
      href: `${siteUrl}/${market}${marketRest ? `/${marketRest}` : ""}`,
    }))
  : [];
const xDefaultHref = currentMarket
  ? `${siteUrl}/${DEFAULT_MARKET}${marketRest ? `/${marketRest}` : ""}`
  : null;

// --- Breadcrumbs + JSON-LD ---
// Los niveles se derivan de la ruta; sólo se enlazan los que tienen página
// índice real en el build (ver INDEX_ROUTES en lib/utils/breadcrumbs.ts).
const crumbs = noindex
  ? []
  : buildBreadcrumbs(pathname, breadcrumbLabel ?? title);

const schemaName = plainify(meta_title || title || config.site.title).trim();
const schemaDescription = plainify(
  description || config.metadata.meta_description,
).trim();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <link rel="shortcut icon" href={config.site.favicon} />
    <meta name="theme-name" content="automark-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <link rel="canonical" href={canonicalUrl} item-prop="url" />
    {
      marketAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      xDefaultHref && (
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      )
    }
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- View Transitions removed to avoid conflicts with GSAP/Lenis/Swiper -->

    <meta name="author" content={config.metadata.meta_author} />
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang.replace("-", "_")} />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- GSAP CDN -->
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/ScrollTrigger.min.js"
    ></script>

    <!-- LENIS CDN -->
    <script
      is:inline
      defer
      src="https://unpkg.com/lenis@1.3.17/dist/lenis.min.js"></script>

    <!-- JSON-LD (Organization + WebSite + WebPage + breadcrumb/tipo de página) -->
    <Schema
      canonicalUrl={canonicalUrl}
      siteUrl={siteUrl}
      name={schemaName}
      description={schemaDescription}
      inLanguage={htmlLang}
      crumbs={crumbs}
      schema={schema}
    />

    <!-- Main UI interactions -->
    <script is:inline defer src="/scripts/main.js"></script>

    <!-- Animations (Modules are deferred automatically by browsers) -->
    <script is:inline type="module" src="/scripts/animations.js"></script>
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    {/* <TwSizeIndicator /> */}
    <Header />
    <main id="main-content" class="overflow-x-hidden md:overflow-x-auto">
      <Breadcrumbs crumbs={crumbs} />
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
