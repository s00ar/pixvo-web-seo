---
// Botón flotante de WhatsApp, visible en todas las páginas. Réplica
// funcional del "whatsapp-float" de v1.1.0, adaptado a la estética
// oscura del theme actual. Mismo número en los tres mercados.
const PHONE = "393921425033";
const PHONE_DISPLAY = "+39 392 142 5033";
const MESSAGE = "Hola, quiero más información sobre Pixvo Growth System.";
const href = `https://wa.me/${PHONE}?text=${encodeURIComponent(MESSAGE)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Escribir a Pixvo por WhatsApp al ${PHONE_DISPLAY}`}
  class="whatsapp-float fixed bottom-6 right-6 z-40 flex items-center gap-3 rounded-full bg-[#25D366] pl-4 pr-5 py-4 text-white shadow-lg shadow-black/40 transition-transform hover:scale-105"
>
  <svg viewBox="0 0 32 32" aria-hidden="true" class="size-6 shrink-0 fill-current">
    <path
      d="M16 3a12 12 0 0 0-10.3 18.2L4 28l7-1.6A12 12 0 1 0 16 3Zm0 21.7a9.6 9.6 0 0 1-4.9-1.3l-.5-.3-3.4.8.9-3.3-.3-.5A9.7 9.7 0 1 1 16 24.7Zm5.3-7.2c-.3-.2-1.7-.9-2-.9-.3-.1-.5-.2-.7.2l-1 1.2c-.2.3-.4.3-.7.1-1.8-.9-3-1.7-4.2-3.8-.3-.5.3-.5.9-1.7.1-.2.1-.4 0-.6l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.4-1.3 1.3-1.3 3.2s1.4 3.7 1.6 4c.2.2 2.7 4.2 6.7 5.7 2.5 1.1 3.5 1.2 4.8 1 .8-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3Z"
    ></path>
  </svg>
  <span class="hidden sm:inline font-medium text-sm">WhatsApp</span>
</a>

<style>
  /* Pulso sutil para llamar la atención sin ser invasivo. */
  .whatsapp-float {
    animation: whatsapp-pulse 2.4s ease-in-out infinite;
  }
  @keyframes whatsapp-pulse {
    0%,
    100% {
      box-shadow:
        0 8px 24px rgb(0 0 0 / 0.35),
        0 0 0 0 rgb(37 211 102 / 0.5);
    }
    50% {
      box-shadow:
        0 8px 24px rgb(0 0 0 / 0.35),
        0 0 0 8px rgb(37 211 102 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      animation: none;
    }
  }
</style>
